# Salin file ini menjadi .env (untuk lokal) atau set sebagai Environment Variables
# di dashboard Vercel (untuk produksi).

# ---- Basis data (WAJIB untuk produksi/Vercel) ----
# Vercel serverless tidak punya disk permanen, jadi gunakan Turso (libSQL).
# Buat gratis di https://turso.tech lalu isi kedua nilai berikut.
# Jika DIKOSONGKAN, aplikasi memakai file lokal (data/widya.db) — hanya untuk dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Kredensial admin awal (dipakai hanya saat database masih kosong) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=widya2026

# ---- Kunci rahasia untuk menandatangani token sesi admin (WAJIB diganti) ----
JWT_SECRET=ganti-dengan-kunci-acak-yang-panjang-dan-rahasia

# ---- Opsional ----
# PORT hanya berpengaruh saat dijalankan lokal (npm start). Vercel mengaturnya otomatis.
PORT=3000
NODE_ENV=development
