# ============================================================
# Widya Nusantara Academy — Environment Variables
# Salin ke .env untuk pengembangan lokal:
#   cp .env.example .env
#   npm run dev        (script sudah memakai --env-file=.env)
# Di Vercel: Project Settings -> Environment Variables.
# JANGAN pernah commit file .env yang berisi nilai sungguhan.
# ============================================================

# --- Database (Turso / libSQL) ----------------------------------
# WAJIB di produksi/Vercel. Filesystem serverless read-only sehingga
# mode file lokal tidak bisa dipakai di sana.
# Alias yang juga dikenali: LIBSQL_URL, DATABASE_URL
TURSO_DATABASE_URL=libsql://nama-database-organisasi.turso.io
# Alias yang juga dikenali: DATABASE_AUTH_TOKEN
TURSO_AUTH_TOKEN=

# Bila kedua variabel di atas kosong DAN aplikasi dijalankan di lokal,
# database otomatis memakai file:./data/widya.db

# --- Kredensial admin ------------------------------------------
# OPSIONAL. Bila DIISI, nilainya bersifat authoritative: akun dengan
# username ini dibuat/diperbarui sebagai SUPERADMIN pada setiap cold start.
#
# Bila DIBIARKAN KOSONG, aplikasi membuat satu akun Super Admin bawaan pada
# inisialisasi pertama. Password akun bawaan TIDAK ada di repository —
# hanya hash scrypt-nya yang tertanam di kode, jadi tidak bisa dibaca
# dari kode sumber maupun dari website. Kredensialnya diserahkan terpisah
# kepada pemilik sistem.
#
# PENTING: jika kamu mengisi ADMIN_PASSWORD lalu mengganti password dari
# panel admin, perbarui juga nilai di sini — kalau tidak, password akan
# tertimpa kembali ke nilai environment saat deploy berikutnya.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Keamanan sesi ---------------------------------------------
# SANGAT DISARANKAN diisi di produksi. Bila kosong, aplikasi membuat
# secret acak lalu menyimpannya di tabel settings (tidak pernah di repo),
# tetapi mengisinya di sini lebih aman & eksplisit.
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Runtime ---------------------------------------------------
PORT=3000
# Set ke "production" agar cookie sesi memakai flag Secure (wajib di HTTPS).
NODE_ENV=development
